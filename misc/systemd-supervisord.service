[Unit]
Description=Systemd Service Supervisor Daemon
Requires=systemd-supervisord.socket
After=network.target systemd-supervisord.socket
ConditionPathExists=/etc/systemd-supervisord/config.yaml

[Service]
Type=notify
ExecStartPre=/usr/bin/systemd-supervisord check
ExecStart=/usr/bin/systemd-supervisord run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
NotifyAccess=main
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
